# ---- 基础 ----
BASE_URL=https://vault.example.com
# 允许注册的邮箱（glob，逗号分隔）；留空=不允许注册
ALLOWED_EMAILS=*@example.com
# 服务端 PBKDF2 存储迭代次数（对 masterPasswordHash 再哈希一层）
PASSWORD_ITERATIONS=600000

# ---- 令牌 ----
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# ---- 存储 ----
# memory | blob
STORE_DRIVER=memory
# Blob 命名空间（Makers 自动创建）
BLOB_STORE=warden
# 仅外部脚本/CI 需要；Functions 内自动鉴权
# BLOB_PROJECT_ID=
# BLOB_TOKEN=

# ---- 功能开关 ----
# 单附件上限（字节），省略=不限
# ATTACHMENT_MAX_BYTES=104857600
# 允许 TOTP ±1 步漂移，默认 true
# ALLOW_TOTP_DRIFT=true

# 网页版（Web Vault）：true=开启（默认），false=不开放，根路径只显示落地页
# 关闭后 Send 分享链接仍会转到 /vault/ 渲染，不影响 Send 功能
# WEB_VAULT_ENABLED=true

# 主密码提示加密口令：* = 不加密（默认，与 Vaultwarden 一致）
# 设为任意随机串则用 Argon2id 派生密钥 + AES-256-GCM 加密存储提示
# 一旦启用不要更换/丢失，否则历史提示无法解密
# HINT_ENCRYPTION_SECRET=*

# 本地 dev 端口（仅 src/dev.js 使用）
PORT=8787

# ---- 发信（项目内直连 SMTP）----
MAIL_ENABLED=true
SMTP_HOST=smtp.qcloudmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM_NAME=Warden
MAIL_FROM=no-reply@example.com
MAIL_DRY_RUN=false

# 主密码提示邮件的发送形式：
#   plain（默认）= 解密后发明文，收到即可用
#   sealed        = 直接发库里的密文，邮件通道无明文；
#                   收件人需用 HINT_ENCRYPTION_SECRET + scripts/decrypt-hint.mjs 解开
# 仅在 HINT_ENCRYPTION_SECRET 不是 * 时 sealed 才生效。
# HINT_EMAIL_MODE=plain