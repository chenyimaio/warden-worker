# ---- 基础 ----
BASE_URL=https://vault.example.com
# 允许注册的邮箱（glob，逗号分隔）；留空 = 不允许注册
ALLOWED_EMAILS=*@example.com
# 可选：服务端 PBKDF2 存储迭代次数，默认 600000
# PASSWORD_ITERATIONS=600000

# ---- 令牌 ----
JWT_SECRET=change-me-access-secret
# 可选：留空则用 HMAC-SHA256(JWT_SECRET, "warden/v1/refresh-token-signing-key") 派生。
# 只有需要单独轮换刷新令牌密钥时才填；从派生改成显式会让所有 refresh token 失效。
# JWT_REFRESH_SECRET=change-me-refresh-secret

# ---- 存储 ----
# 留空 = blob（线上默认）。本地调试可改 memory（进程重启即清空，npm run dev 自动使用）
STORE_DRIVER=blob
# Blob 命名空间（Makers 自动创建）
BLOB_STORE=warden
# 仅外部脚本/CI 需要；Functions 内自动鉴权
# BLOB_PROJECT_ID=
# BLOB_TOKEN=

# ---- 可选开关 ----
# 单次上传上限（字节），同时管附件和文件 Send；默认 6 MiB（EdgeOne 请求体硬上限）
# UPLOAD_MAX_BYTES=6291456
# 上传默认走预签名直传（字节直达 Blob，单文件上限 25 MiB = Blob 单对象上限，无需配置）
# 只有回退到函数内上传时才受上面 UPLOAD_MAX_BYTES 限制
# 允许 TOTP ±1 步漂移，默认 true
# ALLOW_TOTP_DRIFT=true

# ---- 网页版（Web Vault，构建期）----
# true=开启（默认）：构建时下载官方 Web Vault 到 /vault/，根路径 302 到它
# false=不下载：构建更快、产物更小，但根路径会 404（落地页已删除）
# WEB_VAULT_ENABLED=true
# 可选：固定版本 / 换下载源（国内构建机拉 GitHub 慢时用镜像）
# WEB_VAULT_VERSION=v2026.10.1
# WEB_VAULT_BASE_URL=https://github.com/dani-garcia/bw_web_builds/releases/download/v2026.10.1

# ---- 邮件（全部可选）----
# 不配 SMTP_HOST + MAIL_FROM 就不发信：主密码提示接口仍返回 200，只是跳过发送。
# 想启用就取消下面注释并填真实值。
# SMTP_HOST=smtp.qcloudmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password
# MAIL_FROM=no-reply@example.com
# 可选：发件人显示名，默认 Warden
# MAIL_FROM_NAME=Warden
# 可选：true = 只打日志不发信（本地联调）
# MAIL_DRY_RUN=false

# ---- 本地 dev ----
# 仅 src/dev.js 使用
PORT=8787
